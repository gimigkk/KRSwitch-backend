generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  nim            String         @id
  name           String
  email          String         @unique
  role           String         @default("student")
  isActive       Boolean        @default(true)
  picture        String?
  offeredBarters BarterOffer[]  @relation("Offerer")
  takenBarters   BarterOffer[]  @relation("Taker")
  reservedOffers BarterOffer[]  @relation("ReservedFor")
  enrollments    Enrollment[]
  notifications  Notification[]

  @@map("users")
}

model ParallelClass {
  id          Int           @id @default(autoincrement())
  courseCode  String
  courseName  String
  classCode   String
  day         String
  timeStart   String
  timeEnd     String
  room        String
  offeredIn   BarterOffer[] @relation("MyClass")
  wantedIn    BarterOffer[] @relation("WantedClass")
  enrollments Enrollment[]

  @@map("parallel_classes")
}

model Enrollment {
  id              Int           @id @default(autoincrement())
  nim             String
  parallelClassId Int
  user            User          @relation(fields: [nim], references: [nim], onDelete: Cascade, onUpdate: Cascade)
  parallelClass   ParallelClass @relation(fields: [parallelClassId], references: [id], onDelete: Cascade)

  @@unique([nim, parallelClassId])
  @@map("enrollments")
}

model BarterOffer {
  id              Int           @id @default(autoincrement())
  offererNim      String
  myClassId       Int
  wantedClassId   Int?
  type            String        @default("swap")     // "swap" | "pick_drop"
  batchGroupId    String?       // UUID linking batch offers together
  reservedForNim  String?
  status          String        @default("open")
  createdAt       DateTime      @default(now())
  takerNim        String?
  completedAt     DateTime?
  myClass         ParallelClass @relation("MyClass", fields: [myClassId], references: [id], onDelete: Cascade)
  offerer         User          @relation("Offerer", fields: [offererNim], references: [nim], onDelete: Cascade, onUpdate: Cascade)
  taker           User?         @relation("Taker", fields: [takerNim], references: [nim], onDelete: Cascade, onUpdate: Cascade)
  wantedClass     ParallelClass? @relation("WantedClass", fields: [wantedClassId], references: [id], onDelete: Cascade)
  reservedFor     User?          @relation("ReservedFor", fields: [reservedForNim], references: [nim], onDelete: SetNull, onUpdate: Cascade)

  @@index([status])
  @@index([type, status])
  @@index([reservedForNim])
  @@index([offererNim])
  @@index([takerNim])
  @@index([myClassId])
  @@index([wantedClassId])
  @@index([batchGroupId])
  @@map("barter_offers")
}

model Notification {
  id           Int      @id @default(autoincrement())
  recipientNim String
  type         String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  data         Json
  recipient    User     @relation(fields: [recipientNim], references: [nim], onDelete: Cascade, onUpdate: Cascade)

  @@index([recipientNim, read])
  @@index([recipientNim, createdAt(sort: Desc)])
  @@map("notifications")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  timestamp   DateTime @default(now())
  action_type String
  user_nim    String
  details     String

  @@index([user_nim])
  @@index([timestamp(sort: Desc)])
  @@map("activity_logs")
}
